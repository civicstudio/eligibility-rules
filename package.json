{
  "name": "s3-jekyll",
  "version": "1.0.0",
  "description": "jekyll with tailwind to s3 via github actions",
  "dependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "yaml": "^2.7.0"
  },
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./assets/css/tailwind.css -o ./assets/css/main.css --minify",
    "build": "npm run build:css",
    "validate": "node scripts/validate-schemas.js",
    "test": "npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afomi/jekyll-with-tailwind.git"
  },
